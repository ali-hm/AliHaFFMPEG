<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationIcon>app.ico</ApplicationIcon>
        <Version>2.1.0</Version>
        <AssemblyTitle>AliHa FFMPEG</AssemblyTitle>
        <Product>AliHa FFMPEG</Product>
        <Company>Ali Hamidi</Company>
        <Authors>Ali Hamidi</Authors>
        <Description>FFmpeg wrapper and GUI for everyday media conversion</Description>
    </PropertyGroup>

    <ItemGroup>
      <Compile Update="PresetNameForm.cs">
        <SubType>Form</SubType>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AliHaFFMPEG.Core\AliHaFFMPEG.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="app.ico">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
